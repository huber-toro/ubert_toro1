    "# Exploración inicial\n",
    "print(\"Dimensiones:\", df.shape)\n",
    "print(\"\\nInformación del dataset:\")\n",
    "df.info()\n",
    "\n",
    "print(\"\\nEstadísticas descriptivas:\")\n",
    "df.describe(include=\"all\")\n"
   ]
